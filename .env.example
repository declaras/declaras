# ── App ──
DECLARAS_ENV=local
DECLARAS_LOG_LEVEL=INFO
DECLARAS_API_KEYS=dev-key-cambiar

# ── Base de datos (jobs) ──
DECLARAS_DATABASE_URL=sqlite+aiosqlite:///./var/declaras.db

# ── Almacenamiento de documentos ──
DECLARAS_STORAGE_BACKEND=local          # local | gcs
DECLARAS_STORAGE_LOCAL_ROOT=./var/documents
DECLARAS_STORAGE_GCS_BUCKET=

# ── Conector DIAN ──
DECLARAS_DIAN_BASE_URL=https://muisca.dian.gov.co
DECLARAS_DIAN_ADAPTER=fake               # fake | playwright
DECLARAS_DIAN_HEADLESS=true
DECLARAS_DIAN_MAX_CONCURRENT_SESSIONS=2
DECLARAS_DIAN_NAV_TIMEOUT_MS=45000
DECLARAS_DIAN_MAX_LOGIN_ATTEMPTS=2       # la DIAN bloquea al tercer fallo: NO subir a 3
DECLARAS_DIAN_CAPTURE_EVIDENCE=true

# ── Worker ──
DECLARAS_WORKER_ENABLED=true
DECLARAS_WORKER_POLL_INTERVAL_S=2
DECLARAS_WORKER_LEASE_TTL_S=900
